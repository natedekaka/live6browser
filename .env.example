# Salin ke .env lalu sesuaikan bila perlu:  cp .env.example .env

# Kata sandi guru/admin (WAJIB diganti di produksi)
LIVE6BROWSER_TEACHER_PASSWORD=rahasinate

# Kata sandi kelas untuk siswa. Kosongkan agar tidak dipakai.
LIVE6BROWSER_STUDENT_PASSWORD=

# Port
LIVE6BROWSER_TEACHER_PORT=9334
LIVE6BROWSER_STUDENT_PORT=9335

# Alamat bind. 0.0.0.0 = bisa diakses dari HP di WiFi yang sama
LIVE6BROWSER_HOST=0.0.0.0

# Judul tampilan
LIVE6BROWSER_TITLE=Live6Browser

# Nama ruang tetap (opsional, mis. "kelas8a"). Kosong = kode acak saat guru masuk
LIVE6BROWSER_ROOM=

# Direktori data (ruang + gambar)
LIVE6BROWSER_DATA_DIR=./data

# Masa berlaku sesi login (jam)
LIVE6BROWSER_SESSION_HOURS=12

# Batas unggahan gambar (MB) sebelum dikompresi di browser
LIVE6BROWSER_MAX_UPLOAD_MB=12

# Batas papan
LIVE6BROWSER_MAX_BLOCKS=400
LIVE6BROWSER_MAX_BLOCK_CHARS=8000

# Lebar/tinggi maksimum gambar di papan (px)
LIVE6BROWSER_MAX_IMAGE_PX=1920

# Batas pesan chat (karakter)
LIVE6BROWSER_MAX_CHAT_CHARS=500

# Jumlah siswa maksimal per ruang
LIVE6BROWSER_MAX_STUDENTS=150

# Level log: debug | info | warn | error
LIVE6BROWSER_LOG_LEVEL=info
